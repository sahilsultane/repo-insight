# GitHub API Token (required - get from https://github.com/settings/tokens)
GITHUB_TOKEN=your_github_personal_access_token_here

# AI Provider: "gemini" or "openai"
AI_PROVIDER=gemini

# Google Gemini API Key (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Database credentials
DB_USERNAME=repoinsight
DB_PASSWORD=repoinsight123

# JWT Secret (use a strong random string of at least 32 characters)
JWT_SECRET=change_this_to_a_strong_random_secret_key_256bits

# Frontend API base URL (for Docker, use http://backend:8080)
VITE_API_BASE_URL=http://localhost:8080
